<UserControl x:Class="snapwatch.UI.PopUps.StoryLoadingPopUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snapwatch.UI.PopUps"
             mc:Ignorable="d" Visibility="Visible"
             Background="#00000096"
             d:DesignHeight="750" d:DesignWidth="934">
    <Grid Background="Transparent">
        <Border Width="670" Height="500"
                Background="Black"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Background="#fff" Grid.Row="0">
                    <ProgressBar x:Name="ProgressBar"
                                 Height="10"
                                 Minimum="0" Maximum="100"
                                 Value="0"
                                 Foreground="Lime"
                                 Background="Gray"
                                 Margin="0,0,0,10"/>

                    <StackPanel Margin="20,0,20,20">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Font}"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   Margin="0,-5,0,0"/>  
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
