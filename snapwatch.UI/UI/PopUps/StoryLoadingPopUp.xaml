<UserControl x:Class="snapwatch.UI.PopUps.StoryLoadingPopUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snapwatch.UI.PopUps"
             xmlns:components="clr-namespace:snapwatch.UI.Components"
             mc:Ignorable="d" Visibility="Visible"
             Background="#80000000"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    
    <Grid Background="Transparent">
        <Border MinWidth="670" MinHeight="500"
                Background="Black" BorderBrush="#999" BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" Margin="60">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Background="#000" Grid.Row="0">
                    <ProgressBar x:Name="ProgressBar"
                                 Height="10"
                                 Minimum="0" Maximum="100"
                                 Value="0"
                                 Foreground="Lime"
                                 Background="Gray"
                                 Margin="0,0,0,10"/>

                    <StackPanel Margin="20,0,20,20">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Font}"
                                   Text="{Binding ProgressBarText}"
                                   Foreground="White"
                                   FontSize="14"
                                   HorizontalAlignment="Left"
                                   Margin="0,-5,0,0"/>  
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="20,0" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="Посмотри похожие пока идет загрука..." Style="{StaticResource Font}" Foreground="#fff" FontSize="17" Margin="0,10" />

                        <StackPanel Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Movies, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:MovieCardMini Title="{Binding Title}" PosterPath="{Binding PosterPath}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
