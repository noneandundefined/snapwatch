<UserControl x:Class="snapwatch.UI.Components.MovieCardMini"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:snapwatch.UI.Components"
             xmlns:controllers="clr-namespace:snapwatch.UI.Styles.Controllers"
             mc:Ignorable="d" 
             d:Height="230" d:Width="170">
    
    <UserControl.Resources>
        <controllers:ImageUriConvertor x:Key="ImageUriConverter" />
    </UserControl.Resources>

    <StackPanel Margin="0,0,13,15">
        <Grid>
            <Border Width="170" Height="230" CornerRadius="10" Cursor="Hand" x:Name="MovieBlock">
                <!-- Основное изображение -->
                <Border.Background>
                    <ImageBrush x:Name="MovieBrash" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                        <!-- <ImageBrush.ImageSource>
                        <Binding Path="PosterPath" Converter="{StaticResource ImageUriConverter}" /> 
                    </ImageBrush.ImageSource> -->
                        <ImageBrush.Transform>
                            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
                        </ImageBrush.Transform>
                    </ImageBrush>
                </Border.Background>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsMovie" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.02" Value="{x:Static Visibility.Visible}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsMovie" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static Visibility.Collapsed}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Grid x:Name="DetailsMovie" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 40" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#fff" Style="{StaticResource Font}" FontSize="17" Margin="0 0 0 20" TextWrapping="Wrap" MaxWidth="180" TextAlignment="Center" />

                    <Border BorderBrush="#fff" BorderThickness="2" Width="54" Height="54" CornerRadius="20" Padding="5">
                        <Grid x:Name="GridButtonDetailsMovie" Panel.ZIndex="2" Cursor="Hand" Width="41" Height="40" Background="#fff" Tag="{Binding Id}">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,40,40" RadiusX="100" RadiusY="100" x:Name="btn_rectagle" />
                            </Grid.Clip>
                            <fa:FontAwesome x:Name="ico_play" Icon="Play" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2 2 0 0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MovieBlock" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1" />
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsMovie" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
