<UserControl x:Class="snapwatch.snapwatch.UI.UI.Components.MovieCardMini"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snapwatch.snapwatch.UI.UI.Components"
             xmlns:controllers="clr-namespace:snapwatch.UI.Styles.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="240">
    
    <UserControl.Resources>
        <controllers:ImageUriConvertor x:Key="ImageUriConverter" />
    </UserControl.Resources>

    <StackPanel Margin="13,15">
        <Border Width="214" Height="150" CornerRadius="10" Cursor="Hand" x:Name="MovieBlock">
            <!-- Основное изображение -->
            <Border.Background>
                <ImageBrush x:Name="MovieBrash" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                    <ImageBrush.Transform>
                        <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
                    </ImageBrush.Transform>
                </ImageBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsMovie" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.02" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.07" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsMovie" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <StackPanel Margin="0,13">
            <TextBlock Text="The Substance" Style="{StaticResource Font}" Foreground="#fff" 
                       FontSize="17" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                <Label Content="2025" Foreground="#ccc" />
                <Label Content="/" Foreground="#ccc" />
                <Label Content="Triller" Foreground="#ccc" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
