<UserControl x:Class="snapwatch.UI.Components.MovieCardMini"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snapwatch.UI.Components"
             xmlns:controllers="clr-namespace:snapwatch.UI.Styles.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="240">
    
    <UserControl.Resources>
        <controllers:ImageUriConvertor x:Key="ImageUriConverter" />
    </UserControl.Resources>

    <StackPanel Margin="13,15" Cursor="Hand">
        <Border Width="214" Height="150" Cursor="Hand" x:Name="MovieBlock">
            <!-- Основное изображение -->
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/snapwatch.UI/Public/images/gMQibswELoKmB60imE7WFMlCuqY.webp" x:Name="MovieBrash" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                    <ImageBrush.Transform>
                        <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" />
                    </ImageBrush.Transform>
                </ImageBrush>
            </Border.Background>
        </Border>

        <StackPanel Margin="0,13">
            <TextBlock Text="The Substance" Style="{StaticResource Font}" Foreground="#fff" 
                       FontSize="17" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                <Label Content="2025" Foreground="#ccc" />
                <Label Content="/" Foreground="#ccc" />
                <Label Content="Triller" Foreground="#ccc" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
