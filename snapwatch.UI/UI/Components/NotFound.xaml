<UserControl x:Class="snapwatch.UI.Components.NotFound"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snapwatch.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/snapwatch.UI/Public/images/snapwatch-logo.png" Width="170" Opacity="0.68" />
            <Label Content="Не найдено не одного фильма." Style="{StaticResource Font}" Foreground="#fff" FontSize="25" Margin="0,20" />
        </StackPanel>
    </Grid>
</UserControl>
